# Copia este archivo como .env.local y pon tus valores. Nunca subas .env.local a git.

# Proyecto de Supabase (Configuración → API). La llave "publishable/anon" es pública por diseño.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Funciones con IA (apagadas por defecto). 1 = activar.
# VITE_IA_ACTIVA=1   # IA del servidor (requiere ANTHROPIC_API_KEY como secreto en Supabase)
# VITE_IA_PROPIA=1   # "Trae tu propia IA": cada usuario usa su propia llave

# Secretos de las funciones de Supabase (NO van aquí; se guardan con `supabase secrets set`):
#   VAPID_PRIVADA       llave privada para enviar notificaciones push
#   ANTHROPIC_API_KEY   solo si activas la IA del servidor
